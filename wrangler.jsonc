{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archangelgca",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // Static site on Cloudflare Pages (2026) – build output is `build`
  // Deploy via: `bun run build` then `wrangler pages deploy build`
  // or connect GitHub repo with Build command `bun run build` and Output directory `build`
  "assets": {
    "directory": "build",
    "not_found_handling": "404-page"
  }
}